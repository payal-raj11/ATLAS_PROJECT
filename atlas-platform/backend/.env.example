# Copy this to .env and fill in real values before running.

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=atlas
PGUSER=atlas_user
PGPASSWORD=change_me

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
OTP_EXPIRY_MINUTES=5

# Server
PORT=5000
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177
